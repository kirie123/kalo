# OS / editor junk
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# Dependencies & build outputs (sub-project .gitignore files cover the rest)
node_modules/
dist/
target/
__pycache__/
.pytest_cache/

# Design docs stay local; conventions index & troubleshooting ship with the repo
doc/*
!doc/README.md
!doc/troubleshooting/
