{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kalo",
  "version": "0.1.0",
  "identifier": "com.kalo.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Kalo",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "binaries/pi-x86_64-pc-windows-msvc.exe",
      "binaries/photon_rs_bg.wasm",
      "binaries/package.json",
      "binaries/theme",
      "binaries/assets",
      "binaries/export-html",
      "binaries/native",
      "binaries/node_modules"
    ]
  }
}
