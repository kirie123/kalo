{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kalo",
  "version": "0.1.0",
  "identifier": "com.kalo.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Kalo",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "binaries/pi-x86_64-pc-windows-msvc.exe": "binaries/pi-x86_64-pc-windows-msvc.exe",
      "binaries/kalo-gateway-x86_64-pc-windows-msvc.exe": "binaries/kalo-gateway-x86_64-pc-windows-msvc.exe",
      "binaries/photon_rs_bg.wasm": "binaries/photon_rs_bg.wasm",
      "binaries/package.json": "binaries/package.json",
      "binaries/theme": "binaries/theme",
      "binaries/assets": "binaries/assets",
      "binaries/export-html": "binaries/export-html",
      "binaries/native": "binaries/native",
      "binaries/node_modules": "binaries/node_modules",
      "../../internal-skills": "internal-skills"
    }
  }
}
